---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Marcelo Ellwanger" description="The requested portfolio page could not be found. Return to Marcelo Ellwanger's work, profile, or résumé." noindex={true}>
  <section class="error-page wrap">
    <div class="error-grid">
      <div class="error-copy">
        <p class="eyebrow">404 · Route not found</p>
        <h1>This path doesn’t exist anymore.</h1>
        <p>If you followed an old project link, the work may have been renamed or reorganized. The portfolio itself is still here.</p>
        <div class="case-actions">
          <a class="button primary" href="/">Portfolio home ↑</a>
          <a class="button" href="/#work">Selected work ↗</a>
          <a class="button" href="/about/">About Marcelo ↗</a>
          <a class="button" href="/resume/">Résumé ↗</a>
        </div>
      </div>

      <aside class="error-signal mono" aria-label="Route status">
        <div class="error-signal-head"><span>ROUTE / DIAGNOSTIC</span><b>NO MATCH</b></div>
        <strong class="error-code">404</strong>
        <div class="error-readouts">
          <div><span>REQUEST</span><b>UNRESOLVED</b></div>
          <div><span>PORTFOLIO</span><b class="good">ONLINE</b></div>
          <div><span>RECOVERY</span><b>HOME / WORK</b></div>
        </div>
        <div class="error-trace" aria-hidden="true"><i></i><i></i><i></i></div>
      </aside>
    </div>
  </section>

  <style>
    .error-page {
      min-height:calc(100svh - 76px);
      padding-top:clamp(76px,9vh,120px);
      padding-bottom:clamp(76px,9vh,120px);
      display:grid;
      align-items:center;
    }
    .error-grid {
      width:100%;
      display:grid;
      grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);
      gap:clamp(52px,7vw,104px);
      align-items:center;
    }
    .error-copy h1 {
      margin:16px 0 24px;
      max-width:820px;
      font-size:clamp(3.4rem,6.6vw,6.8rem);
      line-height:.92;
      letter-spacing:-.06em;
      font-weight:520;
      text-wrap:balance;
    }
    .error-copy > p:not(.eyebrow) {
      max-width:650px;
      margin:0;
      color:var(--muted);
      font-size:1.05rem;
      line-height:1.75;
      text-wrap:pretty;
    }
    .error-copy .case-actions { margin-top:32px; }

    .error-signal {
      position:relative;
      overflow:hidden;
      min-height:360px;
      padding:20px;
      display:flex;
      flex-direction:column;
      border:1px solid rgba(255,255,255,.09);
      background:
        linear-gradient(rgba(255,255,255,.016) 1px,transparent 1px),
        linear-gradient(90deg,rgba(255,255,255,.012) 1px,transparent 1px),
        linear-gradient(145deg,#101416,#0b0e10);
      background-size:30px 30px,30px 30px,auto;
      box-shadow:0 28px 80px rgba(0,0,0,.24),inset 0 1px 0 rgba(255,255,255,.016);
    }
    .error-signal::before {
      content:"M/E";
      position:absolute;
      right:18px;
      top:34px;
      color:rgba(242,239,233,.03);
      font-family:Inter,ui-sans-serif,system-ui,sans-serif;
      font-size:5.4rem;
      font-weight:800;
      letter-spacing:-.06em;
      pointer-events:none;
    }
    .error-signal-head {
      position:relative;
      z-index:1;
      display:flex;
      justify-content:space-between;
      gap:18px;
      padding-bottom:15px;
      border-bottom:1px solid rgba(255,255,255,.075);
      color:#646d71;
      font-size:.55rem;
      letter-spacing:.11em;
    }
    .error-signal-head b {
      color:#9aa39e;
      font-weight:500;
    }
    .error-code {
      position:relative;
      z-index:1;
      margin:44px 0 36px;
      color:#e7e9e5;
      font-family:Inter,ui-sans-serif,system-ui,sans-serif;
      font-size:clamp(5rem,9vw,7.2rem);
      line-height:.75;
      letter-spacing:-.075em;
      font-weight:530;
    }
    .error-readouts {
      position:relative;
      z-index:1;
      margin-top:auto;
      border-top:1px solid rgba(255,255,255,.075);
    }
    .error-readouts > div {
      min-height:42px;
      display:grid;
      grid-template-columns:1fr auto;
      gap:16px;
      align-items:center;
      border-bottom:1px solid rgba(255,255,255,.055);
      color:#697277;
      font-size:.53rem;
      letter-spacing:.07em;
    }
    .error-readouts > div:last-child { border-bottom:0; }
    .error-readouts b { color:#aab1ae; font-weight:500; }
    .error-readouts .good { color:var(--accent); }
    .error-trace {
      position:absolute;
      z-index:0;
      left:18px;
      right:18px;
      top:47%;
      height:28px;
      opacity:.28;
      pointer-events:none;
    }
    .error-trace i {
      position:absolute;
      left:0;
      right:0;
      height:1px;
      background:linear-gradient(90deg,transparent,rgba(214,255,87,.22) 10%,rgba(214,255,87,.72) 46%,rgba(214,255,87,.15) 84%,transparent);
      transform-origin:center;
    }
    .error-trace i:nth-child(1) { top:4px; transform:skewY(-1.1deg); opacity:.48; }
    .error-trace i:nth-child(2) { top:13px; opacity:.8; }
    .error-trace i:nth-child(3) { top:22px; transform:skewY(1.1deg); opacity:.36; }

    @media (max-width:980px) {
      .error-page { min-height:auto; }
      .error-grid {
        grid-template-columns:1fr;
        gap:42px;
      }
      .error-signal { max-width:620px; width:100%; min-height:300px; }
    }

    @media (max-width:820px) {
      .error-page {
        padding-top:42px;
        padding-bottom:calc(68px + env(safe-area-inset-bottom));
      }
      .error-grid { gap:30px; }
      .error-copy h1 {
        margin-top:12px;
        margin-bottom:18px;
        font-size:clamp(2.8rem,13vw,4rem);
      }
      .error-copy > p:not(.eyebrow) {
        font-size:.96rem;
        line-height:1.67;
      }
      .error-copy .case-actions {
        display:grid;
        grid-template-columns:repeat(2,minmax(0,1fr));
        gap:8px;
        margin-top:24px;
      }
      .error-copy .button {
        min-height:46px;
        width:100%;
        display:flex;
        align-items:center;
        justify-content:center;
        padding-inline:10px;
        font-size:.72rem;
      }
      .error-copy .button:first-child {
        grid-column:1/-1;
        min-height:50px;
      }
      .error-signal {
        min-height:270px;
        padding:16px;
        border-radius:10px;
      }
      .error-code {
        margin:34px 0 28px;
        font-size:4.8rem;
      }
      .error-signal::before { font-size:4.2rem; }
    }

    @media (max-width:390px) {
      .error-copy .case-actions { grid-template-columns:1fr; }
      .error-copy .button:first-child { grid-column:auto; }
      .error-readouts > div {
        grid-template-columns:1fr;
        gap:3px;
        padding:9px 0;
      }
    }
  </style>
</BaseLayout>